# Copy this file to .env and fill in your own keys.
# .env is gitignored and must never be committed.

# Mistral - used for summarisation, extraction and RAG answers
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY="your-mistral-key-here"

# Whisper model size: tiny | base | small | medium | large
# "small" is the accuracy/speed sweet spot on CPU
WHISPER_MODEL="small"

# Sarvam AI - only needed for the Hindi/Hinglish transcription path
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY="your-sarvam-key-here"
SARVAM_STT_MODEL=saaras:v2.5
